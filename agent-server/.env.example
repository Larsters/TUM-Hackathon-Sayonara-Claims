# Cardano Foundation's hosted x402 facilitator on preprod
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
SELLER_PORT=4021

# Optional. Without it the scripts use Koios, which needs no key.
BLOCKFROST_PROJECT_ID=

# Cover pool / insurer: receives research fees and premiums, sends payouts.
# Generate wallets with `npm run wallet`.
POOL_MNEMONIC=
POOL_ADDRESS=addr_test1...

# Ana, the traveller in the demo: pays the research fee and the premium
ANA_MNEMONIC=
ANA_ADDRESS=addr_test1...

# Keeper: the FlightDelayCover contract on Base Sepolia (see ../settlement)
COVER_ADDRESS=0x...
# COVER_FROM_BLOCK=0
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
