# Copy to bsv/.env (git-ignored). Create keys with `npm run keys`.
BSV_NETWORK=test
# The cover agent's own key: it pays premiums from here.
BSV_AGENT_WIF=
# The cover pool's address: premiums go here.
BSV_POOL_ADDRESS=
# 1900 sat stands for the €19 premium in the demo.
BSV_PREMIUM_SATS=1900
# Optional: ARC endpoint for the chosen network (default: Arcade).
# ARC_URL=https://arcade-v2-us-1.bsvblockchain.tech
# Optional: lets the agent decide with the language model.
# OPENAI_API_KEY=
